{
  "rules": [
    {
      "id": "DECL-DEFENSE-002",
      "message": "Assigned() check right after a constructor call is always true and can be removed",
      "severity": "WARNING",
      "languages": ["pascal"],
      "metadata": {"equivalent-of": "RAWPACO-DEFENSE-002"},
      "pattern-either": [
        {"pattern": "$X := $T.Create(...);\nif Assigned($X) then\n  $BODY;"},
        {"pattern": "$X := $T.Create;\nif Assigned($X) then\n  $BODY;"},
        {"pattern": "$X := $T.Create(...);\nif Assigned($X) then\n  ...\nelse\n  ..."},
        {"pattern": "$X := $T.Create;\nif Assigned($X) then\n  ...\nelse\n  ..."}
      ]
    }
  ]
}
