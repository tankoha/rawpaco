{
  "rules": [
    {
      "id": "DECL-SEC-001",
      "message": "string concatenation builds SQL from a literal containing a SQL keyword ($LIT); use parameterized queries instead",
      "severity": "ERROR",
      "languages": ["pascal"],
      "metadata": {"equivalent-of": "RAWPACO-SEC-001"},
      "patterns": [
        {"pattern-either": [{"pattern": "$LIT + $OTHER"}, {"pattern": "$OTHER + $LIT"}]},
        {"metavariable-regex": {"metavariable": "$LIT", "regex": "'([^']|'')*'$"}},
        {"metavariable-regex": {"metavariable": "$LIT", "regex": "(?i)'.*\\b(SELECT|INSERT|UPDATE|DELETE|WHERE|FROM)\\b"}},
        {"pattern-not": "'...' + '...'"}
      ]
    }
  ]
}
